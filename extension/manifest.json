{
  "manifest_version": 3,
  "name": "YM Uncensored",
  "version": "0.6.0",
  "description": "Играет локальные explicit-версии параллельно с веб-плеером Яндекс.Музыки.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*",
    "https://*.music.yandex.ru/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "classic"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://*.music.yandex.ru/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://*.music.yandex.ru/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "YM Uncensored"
  }
}
